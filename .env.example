APP_NAME="Ticket Escalator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD are not needed for SQLite.
# The SQLite file lives at: database/database.sqlite

# ---------------------------------------------------------------
# OpenAI API Key (optional)
# Leave blank to use the built-in keyword-based urgency fallback.
# When set, ticket urgency is determined by GPT-4o-mini.
# ---------------------------------------------------------------
OPENAI_API_KEY=
